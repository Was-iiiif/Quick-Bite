<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.quickbite.controller.fxml.CustomerDashboardController"
      prefWidth="1280" prefHeight="820" style="-fx-background-color:#0E0E10;">
    <children>

        <!-- ============ LEFT ICON NAV RAIL ============ -->
        <VBox prefWidth="74" minWidth="74" maxWidth="74" spacing="22" alignment="TOP_CENTER"
              style="-fx-background-color:#0C0C0E; -fx-border-color:#1F1F24; -fx-border-width:0 1 0 0;">
            <padding><Insets top="24" right="10" bottom="24" left="10"/></padding>
            <children>
                <Button text="⚡" style="-fx-background-color:#FF5722; -fx-text-fill:white; -fx-font-weight:bold; -fx-min-width:44px; -fx-min-height:44px; -fx-background-radius:12px;"/>

                <VBox spacing="16" alignment="TOP_CENTER">
                    <children>
                        <VBox fx:id="navHome" alignment="CENTER" prefWidth="52" onMouseClicked="#handleNavHome"
                              style="-fx-background-color:#23120B; -fx-border-color:#FF5722; -fx-border-radius:10px; -fx-background-radius:10px;">
                            <children>
                                <Label text="⌂" style="-fx-font-size:18px; -fx-text-fill:#FF5722;"/>
                                <Label text="Home" style="-fx-font-size:10px; -fx-font-weight:bold; -fx-text-fill:#FF5722;"/>
                            </children>
                        </VBox>
                        <VBox fx:id="navExplore" alignment="CENTER" prefWidth="52" onMouseClicked="#handleNavExplore">
                            <children>
                                <Label text="🧭" style="-fx-font-size:18px; -fx-text-fill:#71717A;"/>
                                <Label text="Explore" style="-fx-font-size:10px; -fx-text-fill:#71717A;"/>
                            </children>
                        </VBox>
                        <VBox fx:id="navOrders" alignment="CENTER" prefWidth="52" onMouseClicked="#handleNavOrders">
                            <children>
                                <Label text="🛍" style="-fx-font-size:18px; -fx-text-fill:#71717A;"/>
                                <Label text="Orders" style="-fx-font-size:10px; -fx-text-fill:#71717A;"/>
                            </children>
                        </VBox>
                        <VBox fx:id="navSaved" alignment="CENTER" prefWidth="52" onMouseClicked="#handleNavSaved">
                            <children>
                                <Label text="🔖" style="-fx-font-size:18px; -fx-text-fill:#71717A;"/>
                                <Label text="Saved" style="-fx-font-size:10px; -fx-text-fill:#71717A;"/>
                            </children>
                        </VBox>
                    </children>
                </VBox>

                <Region VBox.vgrow="ALWAYS"/>

                <Button fx:id="btnLogout" text="⇥" onAction="#handleLogout"
                        style="-fx-background-color:#1A1A20; -fx-text-fill:#9CA3AF; -fx-min-width:38px; -fx-min-height:38px; -fx-background-radius:19px;"/>

                <StackPane onMouseClicked="#handleOpenProfile">
                    <children>
                        <Label text="A" style="-fx-background-color:#27272A; -fx-text-fill:white; -fx-font-weight:bold; -fx-min-width:36px; -fx-min-height:36px; -fx-background-radius:18px; -fx-alignment:center;"/>
                    </children>
                </StackPane>
            </children>
        </VBox>

        <!-- ============ CENTER SCROLLABLE CONTENT ============ -->
        <ScrollPane fitToWidth="true" HBox.hgrow="ALWAYS" style="-fx-background-color:transparent; -fx-background:#111113;">
            <content>
                <VBox spacing="22" style="-fx-background-color:#111113;">
                    <padding><Insets top="26" right="30" bottom="36" left="30"/></padding>
                    <children>

                        <!-- Top bar: greeting + search + location -->
                        <HBox spacing="16" alignment="CENTER_LEFT">
                            <children>
                                <VBox spacing="2">
                                    <children>
                                        <Label text="QUICK BITE" style="-fx-font-size:10px; -fx-font-weight:bold; -fx-text-fill:#71717A;"/>
                                        <HBox spacing="6" alignment="BASELINE_LEFT">
                                            <children>
                                                <Label fx:id="lblGreeting" text="Hey, Alex 👋" style="-fx-font-size:22px; -fx-font-weight:bold; -fx-text-fill:white;"/>
                                                <Label text="What are you craving?" style="-fx-font-size:14px; -fx-text-fill:#71717A;"/>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS"/>
                                <TextField fx:id="searchField" promptText="🔍  Restaurants, dishes..." prefWidth="250"/>
                                <Label fx:id="locationPill" text="📍 W 72nd St, New York  ▾" onMouseClicked="#handleChangeAddress"
                                       style="-fx-background-color:#18181C; -fx-border-color:#27272F; -fx-border-radius:20px; -fx-background-radius:20px; -fx-padding:8px 14px; -fx-text-fill:#E4E4E7;"/>
                            </children>
                        </HBox>

                        <!-- Recent orders -->
                        <VBox spacing="12">
                            <children>
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="Recent orders" style="-fx-font-size:17px; -fx-font-weight:bold; -fx-text-fill:white;"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label fx:id="lnkViewAllOrders" text="View all" onMouseClicked="#handleViewAllOrders"
                                               style="-fx-font-size:12px; -fx-font-weight:bold; -fx-text-fill:#FF5722;"/>
                                    </children>
                                </HBox>
                                <HBox fx:id="recentOrdersRow" spacing="14"/>
                            </children>
                        </VBox>

                        <!-- Category filter pills -->
                        <HBox fx:id="categoryPillsRow" spacing="10" alignment="CENTER_LEFT">
                            <children>
                                <Button text="+ All" style="-fx-background-color:#FF5722; -fx-text-fill:white; -fx-font-weight:bold; -fx-background-radius:20px; -fx-padding:7px 16px;"/>
                                <Button text="🍕 Pizza" style="-fx-background-color:#191920; -fx-text-fill:#D4D4D8; -fx-border-color:#272730; -fx-background-radius:20px; -fx-padding:7px 16px;"/>
                                <Button text="🍣 Sushi" style="-fx-background-color:#191920; -fx-text-fill:#D4D4D8; -fx-border-color:#272730; -fx-background-radius:20px; -fx-padding:7px 16px;"/>
                                <Button text="🍔 Burgers" style="-fx-background-color:#191920; -fx-text-fill:#D4D4D8; -fx-border-color:#272730; -fx-background-radius:20px; -fx-padding:7px 16px;"/>
                                <Button text="🍜 Thai" style="-fx-background-color:#191920; -fx-text-fill:#D4D4D8; -fx-border-color:#272730; -fx-background-radius:20px; -fx-padding:7px 16px;"/>
                            </children>
                        </HBox>

                        <!-- "Near you" restaurant grid -->
                        <VBox spacing="14">
                            <children>
                                <HBox spacing="8" alignment="BASELINE_LEFT">
                                    <children>
                                        <Label text="Near you" style="-fx-font-size:18px; -fx-font-weight:bold; -fx-text-fill:white;"/>
                                        <Label fx:id="lblNearYouCount" text="6 places" style="-fx-font-size:13px; -fx-text-fill:#71717A;"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Button text="⚡ Filter" style="-fx-background-color:#18181C; -fx-text-fill:#D4D4D8; -fx-border-color:#272730; -fx-background-radius:8px; -fx-padding:5px 12px;"/>
                                    </children>
                                </HBox>
                                <FlowPane fx:id="restaurantGrid" hgap="16" vgap="18"/>
                            </children>
                        </VBox>

                    </children>
                </VBox>
            </content>
        </ScrollPane>

        <!-- ============ RIGHT CART SIDEBAR ============ -->
        <VBox prefWidth="340" minWidth="340" maxWidth="340" spacing="12"
              style="-fx-background-color:#131316; -fx-border-color:#1F1F24; -fx-border-width:0 0 0 1;">
            <padding><Insets top="24" right="20" bottom="24" left="20"/></padding>
            <children>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <children>
                        <Label text="Your cart" style="-fx-font-size:16px; -fx-font-weight:bold; -fx-text-fill:white;"/>
                        <Label fx:id="lblCartCountBadge" text="0 items"
                               style="-fx-background-color:#2D140D; -fx-text-fill:#FF5722; -fx-font-size:10px; -fx-font-weight:bold; -fx-padding:2px 7px; -fx-background-radius:6px;"/>
                    </children>
                </HBox>
                <Label fx:id="lblCartSource" text="From KFC Bangladesh" style="-fx-font-size:11px; -fx-text-fill:#9CA3AF;"/>

                <ScrollPane fitToWidth="true" prefHeight="170" style="-fx-background-color:transparent; -fx-background:transparent;">
                    <content>
                        <VBox fx:id="cartItemsBox" spacing="10"/>
                    </content>
                </ScrollPane>

                <VBox spacing="6" style="-fx-border-color:#22222A; -fx-border-width:1 0 0 0; -fx-padding:10 0 0 0;">
                    <children>
                        <HBox><children>
                            <Label text="Subtotal" style="-fx-font-size:11px; -fx-text-fill:#9CA3AF;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lblSubtotal" text="BDT 0.00" style="-fx-font-size:12px; -fx-text-fill:#E4E4E7;"/>
                        </children></HBox>
                        <HBox><children>
                            <Label text="Delivery" style="-fx-font-size:11px; -fx-text-fill:#9CA3AF;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lblDeliveryFee" text="BDT 65.00" style="-fx-font-size:12px; -fx-text-fill:#E4E4E7;"/>
                        </children></HBox>
                        <HBox><children>
                            <Label text="Service fee" style="-fx-font-size:11px; -fx-text-fill:#9CA3AF;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lblServiceFee" text="BDT 2.50" style="-fx-font-size:12px; -fx-text-fill:#E4E4E7;"/>
                        </children></HBox>
                        <Separator style="-fx-background-color:#22222A;"/>
                        <HBox alignment="CENTER_LEFT"><children>
                            <Label text="Total" style="-fx-font-size:14px; -fx-font-weight:bold; -fx-text-fill:white;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lblTotal" text="BDT 0.00" style="-fx-font-size:16px; -fx-font-weight:bold; -fx-text-fill:white;"/>
                        </children></HBox>
                    </children>
                </VBox>

                <HBox spacing="8" alignment="CENTER_LEFT">
                    <children>
                        <TextField fx:id="txtPromo" promptText="Promo code" HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnApplyPromo" text="Apply" onAction="#handleApplyPromo"
                                style="-fx-background-color:transparent; -fx-text-fill:#FF5722; -fx-font-weight:bold;"/>
                    </children>
                </HBox>

                <Button fx:id="btnPlaceOrder" text="Place order · BDT 0.00" maxWidth="Infinity" onAction="#handleCheckout"
                        style="-fx-background-color:#FF5722; -fx-text-fill:white; -fx-font-size:14px; -fx-font-weight:bold; -fx-padding:13px; -fx-background-radius:10px;"/>
            </children>
        </VBox>

    </children>
</HBox>
