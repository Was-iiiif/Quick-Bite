<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.quickbite.controller.fxml.DeliveryDashboardController"
            prefWidth="980" prefHeight="680" style="-fx-background-color:#F8FAFC;">

    <!-- ============ TOP NAV BAR ============ -->
    <top>
        <HBox spacing="16" alignment="CENTER_LEFT"
              style="-fx-background-color:#1E293B; -fx-padding:12 20;">
            <children>
                <Label text="QuickBite Courier Dispatch" style="-fx-font-size:18px; -fx-font-weight:bold; -fx-text-fill:#FF6B00;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblUser" text="Driver: Dave Rider (Motorbike)" style="-fx-text-fill:#F1F5F9; -fx-font-weight:bold;"/>
                <Label text="Delivery Staff"
                       style="-fx-background-color:#059669; -fx-text-fill:white; -fx-padding:3 8; -fx-background-radius:12px; -fx-font-size:11px;"/>
                <Button fx:id="btnLogout" text="Logout" onAction="#handleLogout"
                        style="-fx-background-color:#EF4444; -fx-text-fill:white; -fx-font-size:12px;"/>
            </children>
        </HBox>
    </top>

    <!-- ============ CENTER: STATUS BANNER + TABS ============ -->
    <center>
        <VBox spacing="16">
            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
            <children>

                <!-- Status banner -->
                <HBox spacing="20" alignment="CENTER_LEFT"
                      style="-fx-background-color:white; -fx-background-radius:8px; -fx-border-color:#E2E8F0; -fx-padding:14;">
                    <children>
                        <Label fx:id="lblDriverStatus" text="Status: Available for Dispatch"
                               style="-fx-font-size:14px; -fx-font-weight:bold; -fx-text-fill:#059669;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblPoolCount" text="Synchronized Pool: Checking..."
                               style="-fx-font-size:12px; -fx-text-fill:#64748B;"/>
                    </children>
                </HBox>

                <!-- Tabbed content -->
                <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                    <tabs>

                        <!-- Tab 1: Active deliveries -->
                        <Tab text="🛵 Assigned &amp; In-Progress Deliveries">
                            <content>
                                <VBox spacing="12">
                                    <padding><Insets top="16"/></padding>
                                    <children>
                                        <TableView fx:id="activeTable" VBox.vgrow="ALWAYS">
                                            <columns>
                                                <TableColumn text="Delivery #" prefWidth="90"/>
                                                <TableColumn text="Order #" prefWidth="80"/>
                                                <TableColumn text="Pickup Restaurant" prefWidth="160"/>
                                                <TableColumn text="Customer" prefWidth="140"/>
                                                <TableColumn text="Drop-off Address" prefWidth="220"/>
                                                <TableColumn text="Status" prefWidth="130"/>
                                            </columns>
                                        </TableView>
                                        <HBox spacing="12" alignment="CENTER_LEFT">
                                            <children>
                                                <Button fx:id="btnPickup" text="🛵 Picked Up from Kitchen (Out for Delivery)" onAction="#handlePickup"
                                                        style="-fx-background-color:#2563EB; -fx-text-fill:white; -fx-font-weight:bold;"/>
                                                <Button fx:id="btnDeliver" text="✔ Mark Delivered (Complete &amp; Release Driver)" onAction="#handleDeliver"
                                                        style="-fx-background-color:#10B981; -fx-text-fill:white; -fx-font-weight:bold;"/>
                                                <Button fx:id="btnRefreshActive" text="🔄 Refresh" onAction="#handleRefresh"
                                                        style="-fx-background-color:#F1F5F9; -fx-text-fill:#0F172A;"/>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </content>
                        </Tab>

                        <!-- Tab 2: Completed history -->
                        <Tab text="📜 Completed Delivery History">
                            <content>
                                <VBox spacing="12">
                                    <padding><Insets top="16"/></padding>
                                    <children>
                                        <TableView fx:id="historyTable" VBox.vgrow="ALWAYS">
                                            <columns>
                                                <TableColumn text="Delivery #" prefWidth="90"/>
                                                <TableColumn text="Order #" prefWidth="80"/>
                                                <TableColumn text="Restaurant" prefWidth="160"/>
                                                <TableColumn text="Delivered To" prefWidth="220"/>
                                                <TableColumn text="Delivered At" prefWidth="150"/>
                                                <TableColumn text="Status" prefWidth="110"/>
                                            </columns>
                                        </TableView>
                                    </children>
                                </VBox>
                            </content>
                        </Tab>

                    </tabs>
                </TabPane>

            </children>
        </VBox>
    </center>

</BorderPane>
